# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

# In production, use a MongoDB user with a password.
MONGODB_URI=mongodb://127.0.0.1:27017/easygenerator-auth

# Development placeholder. Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=development-only-secret-change-me-before-deploying

# Lifetimes: access token in seconds (15 minutes), refresh token in days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Browser origin of the web app, used for the Origin header check.
WEB_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (0 = none).
TRUST_PROXY_HOPS=0

# API docs at /api/docs.
SWAGGER_ENABLED=true

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
