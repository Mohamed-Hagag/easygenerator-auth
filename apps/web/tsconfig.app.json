{
   "compilerOptions": {
      "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
      "target": "es2023",
      "lib": ["ES2023", "DOM"],
      "module": "esnext",
      "types": ["vite/client"],
      "strict": true,
      "skipLibCheck": true,

      /* Bundler mode */
      "moduleResolution": "bundler",
      "verbatimModuleSyntax": true,
      "moduleDetection": "force",
      "noEmit": true,
      "jsx": "react-jsx",

      /* Base-path imports, e.g. 'utils/lib/cn'. Vite reads these via resolve.tsconfigPaths. */
      "paths": {
         "components/*": ["./src/components/*"],
         "hooks/*": ["./src/hooks/*"],
         "pages/*": ["./src/pages/*"],
         "utils/*": ["./src/utils/*"]
      },

      /* Linting */
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "erasableSyntaxOnly": true,
      "noFallthroughCasesInSwitch": true
   },
   "include": ["src"]
}
